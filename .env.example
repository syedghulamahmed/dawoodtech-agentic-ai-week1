# Provider: gemini or ollama
LLM_PROVIDER=gemini

# Gemini: create a key at https://aistudio.google.com/app/apikey
# Keep the real key in .env only. Never commit .env.
LLM_API_KEY=replace_with_your_gemini_api_key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# Ollama alternative (set LLM_PROVIDER=ollama)
# Install Ollama, then pull a tool-capable model, e.g. qwen3:4b.
OLLAMA_BASE_URL=http://localhost:11434/v1
# For Ollama, an arbitrary non-empty key such as "ollama" is accepted by the SDK.
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:4b

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
REQUEST_TIMEOUT_SECONDS=45
MAX_AGENT_STEPS=6
SQLITE_PATH=.data/notes.db
LOG_PATH=logs/agent.log